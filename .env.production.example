# Production environment example for warehouse-management-main
# Copy this file to .env.production and replace the values with real production settings.

MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/wms_production?retryWrites=true&w=majority
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/wms_production?retryWrites=true&w=majority
MONGODB_DB=wms_production
NEXTAUTH_URL=https://your-production-domain.com
NEXTAUTH_SECRET=<secure-random-value>
REVENUE_API_BASE=https://your-production-revenue-api.com
NEXT_PUBLIC_REVENUE_API_BASE=https://your-production-revenue-api.com

# Optional production settings
# ALLOWED_ORIGINS=https://your-production-domain.com
# REVENUE_SERVER_PORT=4000
